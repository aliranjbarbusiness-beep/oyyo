{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oyyo",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f5fc7ead-aea2-42fa-973f-1653df6ba04b","database_name": "oyyo" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4c2276ee6f7040e1a7a384ffb239a64b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
